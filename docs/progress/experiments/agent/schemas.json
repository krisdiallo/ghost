ctors","steps"],"additionalProperties":false}},"required":["version","name","obstacles","devices","cargo"],"additionalProperties":false}},"required":["sandboxId","expectedRevision","definition"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},{"name":"sandbox_add_device","description":"Create a temporary device in a sandbox with ID, kind, label, position and optional bounded profile. Supply expectedRevision. Profile scale uniformly changes mesh and clearance; speed is m/s, ranges are meters. Set airborne:false for a landed drone spawn. Only arms handle payload. Nothing changes in the live warehouse.","inputSchema":{"type":"object","properties":{"sandboxId":{"type":"string","minLength":1,"maxLength":80},"expectedRevision":{"type":"integer","minimum":0,"maximum":9007199254740991},"device":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":80},"kind":{"type":"string","enum":["camera","rover","arm","drone"]},"label":{"type":"string","minLength":1,"maxLength":80},"position":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"},{"type":"number"}],"items":false,"minItems":3,"maxItems":3},"heading":{"type":"number","minimum":-3.141592653589793,"maximum":3.141592653589793},"pan":{"type":"number","minimum":-180,"maximum":180},"tilt":{"type":"number","minimum":-90,"maximum":30},"airborne":{"type":"boolean"},"profile":{"type":"object","properties":{"scale":{"type":"number","minimum":0.5,"maximum":1.5},"speed":{"type":"number","minimum":0,"maximum":6},"telemetryRange":{"type":"number","minimum":1,"maximum":60},"inspectRange":{"anyOf":[{"type":"number","minimum":0.5,"maximum":60},{"type":"null"}]},"payloadKg":{"anyOf":[{"type":"number","minimum":0,"maximum":100},{"type":"null"}]}},"additionalProperties":false}},"required":["id","kind","label","position"],"additionalProperties":false}},"required":["sandboxId","expectedRevision","device"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},{"name":"sandbox_delete","description":"Delete an unleased draft sandbox. Existing experiment forks and retained reports remain independent. Export its definition first if needed.","inputSchema":{"type":"object","properties":{"sandboxId":{"type":"string","minLength":1,"maxLength":80}},"required":["sandboxId"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true,"openWorldHint":false}},{"name":"experiment_templates","description":"Get explicit starter workflow/device definitions and candidate parameters, including a standard-vs-compact drone aisle-fit trial. Templates are deterministic scripts, not agent decisions.","inputSchema":{"type":"object","properties":{},"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},{"name":"experiment_run","description":"Fork a sandbox's frozen definition and execute a typed sequential workflow. Actors map role names to device IDs; each step names an actor and command. Use saved workflow or provide one. Supply expectedRevision to reject a stale preview. Returns immediately with run ID; poll experiment_inspect. Simulated time is independent of playbackRate (1–8). Commands face the same leases, bounds, static collisions and sensor/inspection rules as manual control. Defaults stop on error and require safe end state.","inputSchema":{"type":"object","properties":{"sandboxId":{"type":"string","minLength":1,"maxLength":80},"expectedRevision":{"type":"integer","minimum":0,"maximum":9007199254740991},"workflow":{"type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":80},"actors":{"type":"object","propertyNames":{"type":"string","pattern":"^[a-zA-Z][a-zA-Z0-9_-]{0,31}$"},"additionalProperties":{"type":"string","minLength":1,"maxLength":80}},"steps":{"minItems":1,"maxItems":64,"type":"array","items":{"type":"object","properties":{"actor":{"type":"string","minLength":1,"maxLength":80},"label":{"type":"string","minLength":1,"maxLength":80},"dwellSeconds":{"type":"number","minimum":0,"maximum":60},"command":{"oneOf":[{"type":"object","properties":{"type":{"type":"string","const":"move"},"x":{"type":"number"},"z":{"type":"number"},"y":{"type":"number"}},"required":["type","x","z"],"additionalProperties":false},{"type":"object","properties":{"type":{"type":"string","const":"look"},"pan":{"type":"number","minimum":-180,"maximum":180},"tilt":{"type":"number","minimum":-90,"maximum":30}},"required":["type","pan","tilt"],"additionalProperties":false},{"type":"object","properties":{"type":{"type":"string","const":"inspect"},"objectId":{"type":"string","minLength":1,"maxLength":80}},"required":["type","objectId"],"additionalProperties":false},{"type":"object","properties":{"type":{"type":"string","const":"preset"},"preset":{"type":"string","enum":["home","reach","drop"]}},"required":["type","preset"],"additionalProperties":false},{"type":"object","properties":{"type":{"type":"string","const":"grasp"},"objectId":{"type":"string","minLength":1,"maxLength":80}},"required":["type","objectId"],"additionalProperties":false},{"type":"object","properties":{"type":{"type":"string","const":"place"}},"required":["type"],"additionalProperties":false},{"type":"object","properties":{"type":{"type":"string","const":"takeoff"}},"required":["type"],"additionalProperties":false},{"type":"object","properties":{"type":{"type":"string","const":"land"}},"required":["type"],"additionalProperties":false},{"type":"object","properties":{"type":{"type":"string","const":"stop"}},"required":["type"],"additionalProperties":false}]}},"required":["actor","command"],"additionalProperties":false}},"stopOnError":{"default":true,"type":"boolean"},"maxSimulatedSeconds":{"default":180,"type":"number","minimum":5,"maximum":300},"requireSafeEnd":{"default":true,"type":"boolean"}},"required":["name","actors","steps"],"additionalProperties":false},"playbackRate":{"default":4,"type":"integer","minimum":1,"maximum":8}},"required":["sandboxId"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},{"name":"experiment_inspect","description":"Read a run's exact frozen definition, workflow, step trace, metrics, fingerprints and assumptions. Set includeSnapshot for spectator state or imageResourceId for an actual JPEG from a trial device. Run state is read-only; use a new trial for changes. Operator access is not a blind agent benchmark.","inputSchema":{"type":"object","properties":{"runId":{"type":"string","minLength":1,"maxLength":80},"includeSnapshot":{"default":false,"type":"boolean"},"imageResourceId":{"type":"string","minLength":1,"maxLength":80}},"required":["runId"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},{"name":"experiment_cancel","description":"Cancel a running experiment, stop pending motion and release its leases. Captured progress remains in the report. This does not auto-land a drone or place held cargo; report safeEndState records recovery needs.","inputSchema":{"type":"object","properties":{"runId":{"type":"string","minLength":1,"maxLength":80}},"required":["runId"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},{"name":"experiment_compare","description":"Compare 2–4 retained runs. Controlled comparisons require the same layout/cargo, workflow, actor kinds and launch poses; device profiles may differ. Failed/cancelled or mismatched runs are never advertised as speed improvements.","inputSchema":{"type":"object","properties":{"runIds":{"minItems":2,"maxItems":4,"type":"array","items":{"type":"string","minLength":1,"maxLength":80}}},"required":["runIds"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}}]}
