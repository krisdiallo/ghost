e","actors","steps"],"additionalProperties":false}},"required":["version","name","obstacles","devices","cargo"],"additionalProperties":false}},"required":["name"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},{"name":"sandbox_inspect","description":"Read a sandbox definition and spectator snapshot. This is operator scenario data, not a sensor observation. Save the versioned definition as JSON for import through sandbox_create.","inputSchema":{"type":"object","properties":{"sandboxId":{"type":"string","minLength":1,"maxLength":80}},"required":["sandboxId"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},{"name":"sandbox_update","description":"Atomically replace a sandbox definition, including structures, cargo, device profiles and optional saved workflow. Supply expectedRevision from sandbox_inspect to prevent lost edits. Running/completed experiments keep their frozen definitions.","inputSchema":{"type":"object","properties":{"sandboxId":{"type":"string","minLength":1,"maxLength":80},"expectedRevision":{"type":"integer","minimum":0,"maximum":9007199254740991},"definition":{"type":"object","properties":{"version":{"type":"number","const":1},"name":{"type":"string","minLength":1,"maxLength":80},"obstacles":{"maxItems":128,"type":"array","items":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":80},"label":{"type":"string","minLength":1,"maxLength":80},"kind":{"type":"string","enum":["rack","wall","column","freight","mezzanine"]},"min":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"},{"type":"number"}],"items":false,"minItems":3,"maxItems":3},"max":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"},{"type":"number"}],"items":false,"minItems":3,"maxItems":3}},"required":["id","label","kind","min","max"],"additionalProperties":false}},"devices":{"minItems":1,"maxItems":12,"type":"array","items":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":80},"kind":{"type":"string","enum":["camera","rover","arm","drone"]},"label":{"type":"string","minLength":1,"maxLength":80},"position":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"},{"type":"number"}],"items":false,"minItems":3,"maxItems":3},"heading":{"type":"number","minimum":-3.141592653589793,"maximum":3.141592653589793},"pan":{"type":"number","minimum":-180,"maximum":180},"tilt":{"type":"number","minimum":-90,"maximum":30},"airborne":{"type":"boolean"},"profile":{"type":"object","properties":{"scale":{"type":"number","minimum":0.5,"maximum":1.5},"speed":{"type":"number","minimum":0,"maximum":6},"telemetryRange":{"type":"number","minimum":1,"maximum":60},"inspectRange":{"anyOf":[{"type":"number","minimum":0.5,"maximum":60},{"type":"null"}]},"payloadKg":{"anyOf":[{"type":"number","minimum":0,"maximum":100},{"type":"null"}]}},"additionalProperties":false}},"required":["id","kind","label","position"],"additionalProperties":false}},"cargo":{"maxItems":32,"type":"array","items":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":80},"label":{"type":"string","minLength":1,"maxLength":80},"position":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"},{"type":"number"}],"items":false,"minItems":3,"maxItems":3},"condition":{"type":"string","maxLength":240},"massKg":{"type":"number","minimum":0.01,"maximum":1000}},"required":["id","label","position","condition"],"additionalProperties":false}},"workflow":{"type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":80},"actors":{"type":"object","propertyNames":{"type":"string","pattern":"^[a-zA-Z][a-zA-Z0-9_-]{0,31}$"},"additionalProperties":{"type":"string","minLength":1,"maxLength":80}},"steps":{"minItems":1,"maxItems":64,"type":"array