  "workflow": {
    "name": "North aisle inspection",
    "actors": {
      "vehicle": "trial-drone"
    },
    "steps": [
      {
        "actor": "vehicle",
        "label": "Take off in the cross-aisle",
        "command": {
          "type": "takeoff"
        }
      },
      {
        "actor": "vehicle",
        "label": "Pass between the storage bays",
        "command": {
          "type": "move",
          "x": -20,
          "z": -21,
          "y": 2.8
        }
      },
      {
        "actor": "vehicle",
        "label": "Approach storage cargo",
        "command": {
          "type": "move",
          "x": -10,
          "z": -21,
          "y": 2.8
        }
      },
      {
        "actor": "vehicle",
        "label": "Aim toward the inspection",
        "command": {
          "type": "look",
          "pan": 28,
          "tilt": -34
        }
      },
      {
        "actor": "vehicle",
        "label": "Inspect the tagged crate",
        "dwellSeconds": 2,
        "command": {
          "type": "inspect",
          "objectId": "crate-12"
        }
      },
      {
        "actor": "vehicle",
        "label": "Land in the clear aisle",
        "command": {
          "type": "land"
        }
      }
    ],
    "stopOnError": true,
    "maxSimulatedSeconds": 90,
    "requireSafeEnd": true
  }
